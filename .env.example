# Generate with: node -e "require('argon2').hash('change-me',{type:require('argon2').argon2id}).then(console.log)"
# Wrap the value in single quotes when Docker Compose will read this file.
RAC_PASSWORD_HASH=
# Generate each secret separately with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
RAC_SESSION_SECRET=
# Share only this dedicated secret across mutually configured console instances.
RAC_INSTANCE_STATUS_SECRET=
RAC_CONFIG=/absolute/path/remote-agent-console.json
RAC_LOG_LEVEL=info
# Docker Compose only: UID that owns the host tmux server (normally 1000).
HOST_UID=1000
# docker compose proxy: use 127.0.0.1 for linux host networking
RAC_PROJECT_PROXY_HOST=127.0.0.1

# Optional ChatGPT MCP and Realtime voice integration.
RAC_OPENAI_API_KEY=
RAC_REALTIME_MCP_TOKEN=
# Use the same base64url-encoded 32-byte secret on federated servers.
RAC_INTEGRATION_FEDERATION_SECRET=

# Docker Compose only: absolute host path of the tunnel credentials JSON.
CLOUDFLARED_CREDENTIALS_FILE=/absolute/path/.cloudflared/tunnel-uuid.json
