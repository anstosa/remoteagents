  "_note": "Fed to claudeAdapter.recognizes. It classifies one process; wrappers (srt) are ancestors and tool children (bash -c) are descendants — both noMatch.",
  "match": [
    { "name": "native claude", "comm": "claude", "argv": ["claude"] },
    { "name": "claude via absolute path", "comm": "claude", "argv": ["/home/tony/.local/bin/claude", "--continue"] },
    { "name": "launcher script whose comm is node", "comm": "node", "argv": ["/home/tony/.local/bin/claude", "--continue"] },
    { "name": "node running the packaged cli", "comm": "node", "argv": ["/usr/bin/node", "/home/tony/.nvm/versions/node/v24.19.0/lib/node_modules/@anthropic-ai/claude-code/cli.js"] },
